# ─────────────────────────────────────────────────────────────────
# Auditor — environment configuration (copy to .env and fill in)
#
# Nothing here is REQUIRED: the engine and dashboard run fully
# offline with no keys. Everything below is optional.
# ─────────────────────────────────────────────────────────────────

# ── Optional: LLM enrichment for deeper, code-specific remediation ──
# Any OpenAI-compatible provider works. Groq has a free tier: https://console.groq.com
# (GROQ_API_KEY is also accepted as a fallback for AUDITOR_LLM_API_KEY)
AUDITOR_LLM_PROVIDER=groq
AUDITOR_LLM_API_KEY=
AUDITOR_LLM_MODEL=llama-3.3-70b-versatile
# AUDITOR_LLM_BASE_URL=https://api.groq.com/openai/v1
# Fully offline alternative: AUDITOR_LLM_PROVIDER=ollama + AUDITOR_LLM_BASE_URL=http://localhost:11434/v1

# ── Dashboard (Next.js) settings ──
# Python interpreter that has the auditor engine installed (default: python3)
# Point this at your uv venv for reliability, e.g.:
# AUDITOR_PYTHON=/absolute/path/to/auditor-engine/.venv/bin/python
# AUDITOR_PYTHON=

# Directories the dashboard is allowed to scan, colon-separated (default: your home dir)
# Tighten this if you ever expose the dashboard beyond localhost.
# AUDITOR_ALLOWED_ROOTS=/home/you:/home/you/projects
